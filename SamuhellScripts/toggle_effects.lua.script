-- Disable Magic Effects Hotkey Button
-- Author: SamuHell
-- Clicks the hotkey assigned to the "Disable Magic Effects" function.
-- This version acts as a button only, as the on/off state cannot be read by the script.

-- #################### CONFIGURATION ####################
local TOGGLE_HOTKEY = "l"
local ICON_ITEM_ID = 3248

-- Position managed by HudLayout
local GROUP = "scripts"
local SLOT = 14
-- ######################################################


-- This will hold our HUD object.
local effectsButtonIcon = nil
local effectsLabel = nil

-- This function is called when the HUD icon is clicked.
local function pressToggleHotkey()
    print(">> Simulating '" .. TOGGLE_HOTKEY .. "' key press to toggle magic effects.")

    -- Parse the hotkey string to get its key code and modifier.
    local success, modifier, key = HotkeyManager.parseKeyCombination(TOGGLE_HOTKEY)

    if success then
        -- Send the key press event to the client.
        Client.sendHotkey(key, modifier)
    else
        print(">> ERROR: Could not parse the configured hotkey: '" .. TOGGLE_HOTKEY .. "'")
    end
end

local function load()
    local pos = HudLayout.getSlotPosition(GROUP, SLOT)
    effectsButtonIcon = HUD.new(pos.x, pos.y, ICON_ITEM_ID, true)
    effectsLabel = HUD.new(pos.x + 36, pos.y + 8, "Effects", true)

    if effectsButtonIcon then
        effectsButtonIcon:setCallback(pressToggleHotkey)
        HudLayout.registerElement(GROUP, SLOT, effectsButtonIcon, 0, 0)

        if effectsLabel then
            effectsLabel:setColor(200, 200, 200)
            effectsLabel:setFontSize(9)
            HudLayout.registerElement(GROUP, SLOT, effectsLabel, 36, 8)
        end

        print("> Magic Effects Button HUD loaded.")
    else
        print("> ERROR: Failed to create Magic Effects Button HUD.")
    end
end

local function unload()
    if effectsButtonIcon then HudLayout.unregisterElement(effectsButtonIcon); effectsButtonIcon:destroy(); effectsButtonIcon = nil end
    if effectsLabel then HudLayout.unregisterElement(effectsLabel); effectsLabel:destroy(); effectsLabel = nil end
    print("> Magic Effects Button HUD unloaded.")
end

return {
    load = load,
    unload = unload
}
