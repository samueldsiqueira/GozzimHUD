-- Auto-Loot on Kill Toggle HUD for Zerobot
-- Author: SamuHell
-- Creates a clickable icon to toggle an event-driven auto-looter.
-- Uses Game.lootCorpse(x, y, z) to loot nearby corpses when a kill is detected.

-- #################### CONFIGURATION ####################
-- Item ID for the icon. A loot bag (23721).
local ICON_ITEM_ID = 23721

-- Position managed by HudLayout
local GROUP = "scripts"
local SLOT = 9

-- Max distance (in tiles)
local LOOT_RANGE = 3
local LOOT_COOLDOWN_MS = 500

-- Opacity
local OPACITY_ON = 1.0
local OPACITY_OFF = 0.5
-- ######################################################


-- This variable tracks whether auto-looting is active.
local isAutoLootActive = true

-- This variable tracks the last time the loot command was triggered.
local lastLootTriggerTime = 0

-- This will hold our HUD object.
local autoLootIcon = nil
local lootLabel = nil

-- Finds all corpse tiles within LOOT_RANGE of the player and loots them.
local function lootNearbyCorpses()
    local myPlayer = Creature(Player.getId())
    if not myPlayer then return end

    local playerPos = myPlayer:getPosition()
    if not playerPos then return end

    local tiles = Map.getTiles()
    if not tiles then return end

    for _, tile in ipairs(tiles) do
        local tilePos = tile.pos

        -- Only consider tiles on the same floor and within range.
        if tilePos.z == playerPos.z then
            local dx = math.abs(tilePos.x - playerPos.x)
            local dy = math.abs(tilePos.y - playerPos.y)

            if dx <= LOOT_RANGE and dy <= LOOT_RANGE then
                -- Check if any item on this tile is a corpse (stackable containers).
                for _, thing in ipairs(tile.things) do
                    if thing.isCorpse then
                        Game.lootCorpse(tilePos.x, tilePos.y, tilePos.z)
                        break -- One loot action per tile is enough.
                    end
                end
            end
        end
    end
end

-- This function is called when the HUD icon is clicked.
local function toggleAutoLoot()
    isAutoLootActive = not isAutoLootActive

    if isAutoLootActive then
        autoLootIcon:setOpacity(OPACITY_ON)
        if lootLabel then lootLabel:setColor(80, 220, 80) end
        print("> Auto-Loot on Kill ENABLED.")
    else
        autoLootIcon:setOpacity(OPACITY_OFF)
        if lootLabel then lootLabel:setColor(160, 160, 160) end
        print("> Auto-Loot on Kill DISABLED.")
    end
end

-- This function is the event handler for game messages.
-- It triggers the loot action when a monster's death is detected.
local function onTextMessage(messageData)
    -- Only proceed if the feature is toggled on.
    if not isAutoLootActive then return end

    -- Trigger on experience or loot messages (signs of a kill).
    local messageType = messageData.messageType
    if messageType == Enums.MessageTypes.MESSAGE_LOOT or messageType == Enums.MessageTypes.MESSAGE_EXPERIENCE then

        -- Check if the cooldown has passed since the last loot trigger.
        local currentTime = os.clock() * 1000
        if currentTime - lastLootTriggerTime > LOOT_COOLDOWN_MS then
            lastLootTriggerTime = currentTime
            -- Small delay to let the corpse appear on the map.
            Timer.new("AutoLootTimer", function()
                lootNearbyCorpses()
                destroyTimer("AutoLootTimer")
            end, 300, true)
        end
    end
end

local function load()
    local pos = HudLayout.getSlotPosition(GROUP, SLOT)
    autoLootIcon = HUD.new(pos.x, pos.y, ICON_ITEM_ID, true)
    lootLabel = HUD.new(pos.x + 36, pos.y + 8, "Loot", true)

    if autoLootIcon then
        autoLootIcon:setOpacity(OPACITY_ON)
        autoLootIcon:setCallback(toggleAutoLoot)
        HudLayout.registerElement(GROUP, SLOT, autoLootIcon, 0, 0)

        if lootLabel then
            lootLabel:setColor(80, 220, 80)
            lootLabel:setFontSize(9)
            HudLayout.registerElement(GROUP, SLOT, lootLabel, 36, 8)
        end

        -- Register our onTextMessage function to listen for game messages.
        Game.registerEvent(Game.Events.TEXT_MESSAGE, onTextMessage)

        -- Print a confirmation message in the Zerobot console.
        print("> Auto-Loot on Kill HUD loaded.")
    else
        print("> ERROR: Failed to create Auto-Loot on Kill HUD.")
    end
end

local function unload()
    if autoLootIcon then HudLayout.unregisterElement(autoLootIcon); autoLootIcon:destroy(); autoLootIcon = nil end
    if lootLabel then HudLayout.unregisterElement(lootLabel); lootLabel:destroy(); lootLabel = nil end
    Game.unregisterEvent(Game.Events.TEXT_MESSAGE, onTextMessage)
    destroyTimer("AutoLootTimer")
    print("> Auto-Loot on Kill HUD unloaded.")
end

return {
    load = load,
    unload = unload
}
