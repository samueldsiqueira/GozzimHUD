-- CaveBot Toggle HUD for Zerobot
-- Author: SamuHell
-- Toggles the native CaveBot system on/off via clickable icon.

-- #################### CONFIGURATION ####################
-- Item ID para o ícone: Tibia Tiara (7440) — parece uma bússola/rota
local ICON_ITEM_ID = 7440

-- Position managed by HudLayout
local GROUP = "scripts"
local SLOT = 3

-- Intervalo de sincronização visual (ms)
local SYNC_INTERVAL_MS = 200

-- Opacidade ON vs OFF
local OPACITY_ON  = 1.0
local OPACITY_OFF = 0.4
-- ######################################################

local caveBotIcon = nil
local caveBotLabel = nil

-- ─── Atualiza a aparência do ícone com base no estado real do Engine ─────
local function updateIconState()
    if not caveBotIcon then return end
    if Engine.isCaveBotEnabled() then
        caveBotIcon:setOpacity(OPACITY_ON)
        if caveBotLabel then caveBotLabel:setColor(80, 220, 80) end
    else
        caveBotIcon:setOpacity(OPACITY_OFF)
        if caveBotLabel then caveBotLabel:setColor(160, 160, 160) end
    end
end

-- ─── Toggle: ativa ou desativa o CaveBot ─────────────────────
local function toggleCaveBot()
    local current = Engine.isCaveBotEnabled()
    Engine.enableCaveBot(not current)
    Timer.new("UpdateCaveBotDelay", function()
        updateIconState()
        if not current then
            print("> CaveBot ENABLED.")
        else
            print("> CaveBot DISABLED.")
        end
    end, 100, false)
end

-- ─── Module API ──────────────────────────────────────────────
local function load()
    local pos = HudLayout.getSlotPosition(GROUP, SLOT)
    caveBotIcon = HUD.new(pos.x, pos.y, ICON_ITEM_ID, true)
    caveBotLabel = HUD.new(pos.x + 36, pos.y + 8, "CaveBot", true)

    if caveBotIcon then
        caveBotIcon:setCallback(toggleCaveBot)
        HudLayout.registerElement(GROUP, SLOT, caveBotIcon, 0, 0)

        if caveBotLabel then
            caveBotLabel:setFontSize(9)
            HudLayout.registerElement(GROUP, SLOT, caveBotLabel, 36, 8)
        end

        updateIconState()
        Timer.new("CaveBotSyncTimer", updateIconState, SYNC_INTERVAL_MS, true)
        print("> CaveBot Toggle HUD loaded.")
    else
        print("> ERROR: Failed to create CaveBot Toggle HUD.")
    end
end

local function unload()
    if caveBotIcon then HudLayout.unregisterElement(caveBotIcon); caveBotIcon:destroy(); caveBotIcon = nil end
    if caveBotLabel then HudLayout.unregisterElement(caveBotLabel); caveBotLabel:destroy(); caveBotLabel = nil end
    destroyTimer("CaveBotSyncTimer")
    print("> CaveBot Toggle HUD unloaded.")
end

return {
    load = load,
    unload = unload
}
