-- FPS & Latency Display for Zerobot
-- Author: SamuHell
-- Displays current FPS and color-coded latency in the top-left corner.

-- #################### CONFIGURATION ####################
local UPDATE_INTERVAL_MS = 1000

-- Layout group and slots (managed by HudLayout)
local GROUP = "info"
local SLOT_FPS = 0
local SLOT_LATENCY = 1

-- Latency thresholds (in milliseconds) for color coding.
local GOOD_LATENCY_THRESHOLD = 150
local BAD_LATENCY_THRESHOLD = 300

-- Color definitions (R, G, B).
local COLOR_GOOD = { r = 100, g = 255, b = 100 }
local COLOR_OKAY = { r = 255, g = 255, b = 100 }
local COLOR_BAD = { r = 255, g = 100, b = 100 }
local COLOR_FPS = { r = 200, g = 200, b = 200 }
-- ######################################################


-- State tracking variables
local fpsHud = nil
local latencyHud = nil
local lastLatencyColor = nil

-- The main loop to update the display.
local function updateDisplay()
    if not Client.isConnected() then
        return
    end

    if fpsHud then
        local currentFps = math.floor(Client.getFps())
        fpsHud:setText("FPS: " .. tostring(currentFps))
    end

    if latencyHud then
        local currentLatency = Client.getLatency()
        latencyHud:setText("Ping: " .. tostring(currentLatency) .. "ms")

        local newColor
        if currentLatency <= GOOD_LATENCY_THRESHOLD then
            newColor = COLOR_GOOD
        elseif currentLatency > BAD_LATENCY_THRESHOLD then
            newColor = COLOR_BAD
        else
            newColor = COLOR_OKAY
        end

        if newColor ~= lastLatencyColor then
            latencyHud:setColor(newColor.r, newColor.g, newColor.b)
            lastLatencyColor = newColor
        end
    end
end

local function load()
    -- Get positions from layout manager
    local fpsPos = HudLayout.getSlotPosition(GROUP, SLOT_FPS)
    local latPos = HudLayout.getSlotPosition(GROUP, SLOT_LATENCY)

    fpsHud = HUD.new(fpsPos.x, fpsPos.y, "FPS: ", true)
    latencyHud = HUD.new(latPos.x, latPos.y, "Ping: ", true)

    if fpsHud and latencyHud then
        fpsHud:setColor(COLOR_FPS.r, COLOR_FPS.g, COLOR_FPS.b)
        latencyHud:setColor(COLOR_OKAY.r, COLOR_OKAY.g, COLOR_OKAY.b)

        -- Register elements for live repositioning
        HudLayout.registerElement(GROUP, SLOT_FPS, fpsHud, 0, 0)
        HudLayout.registerElement(GROUP, SLOT_LATENCY, latencyHud, 0, 0)

        updateDisplay()
        Timer.new("InfoDisplayTimer", updateDisplay, UPDATE_INTERVAL_MS, true)
        print(">> FPS & Latency Display script loaded.")
    else
        print(">> ERROR: Failed to create FPS & Latency HUDs.")
    end
end

local function unload()
    if fpsHud then
        HudLayout.unregisterElement(fpsHud)
        fpsHud:destroy()
        fpsHud = nil
    end
    if latencyHud then
        HudLayout.unregisterElement(latencyHud)
        latencyHud:destroy()
        latencyHud = nil
    end
    destroyTimer("InfoDisplayTimer")
    lastLatencyColor = nil
    print(">> FPS & Latency Display script unloaded.")
end

return {
    load = load,
    unload = unload
}
